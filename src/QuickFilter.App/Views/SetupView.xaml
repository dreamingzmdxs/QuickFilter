<UserControl
    x:Class="QuickFilter.App.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="48,36" MaxWidth="780" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="图片快速筛选" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="指定源目录与两个目标目录，逐张筛选图片。&#10;鼠标按住图片左滑/右滑分入左右目录，上滑删除，下滑跳过；也可使用方向键或 WASD（↑/W 删除，↓/S 跳过）。"
                       TextWrapping="Wrap" Opacity="0.8" />

            <!-- 继续上次会话（顶部显眼入口） -->
            <Border x:Name="ResumePanel" Visibility="Collapsed" Background="#2230A0D0" CornerRadius="10" Padding="16,12" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                    <Button x:Name="ResumeButton" Content="▶ 继续上次会话" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" Padding="28,8" Click="Resume_Click" />
                    <TextBlock x:Name="ResumeInfoText" Foreground="Gray" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <TextBlock Text="目录配置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

            <TextBlock Text="源目录（必填）" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceBox" PlaceholderText="选择包含图片的文件夹" />
                <Button Grid.Column="1" Content="浏览…" Click="BrowseSource_Click" />
            </Grid>

            <TextBlock Text="左目标目录（必填）" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LeftBox" PlaceholderText="左滑 / ← / A 分入的目录" />
                <Button Grid.Column="1" Content="浏览…" Click="BrowseLeft_Click" />
            </Grid>

            <TextBlock Text="右目标目录（必填）" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RightBox" PlaceholderText="右滑 / → / D 分入的目录" />
                <Button Grid.Column="1" Content="浏览…" Click="BrowseRight_Click" />
            </Grid>

            <TextBlock Text="已删除目录（可选）" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DeletedBox" PlaceholderText="留空则使用：源目录\已删除（上滑 / ↑ / W 移入）" />
                <Button Grid.Column="1" Content="浏览…" Click="BrowseDeleted_Click" />
            </Grid>

            <TextBlock Text="排序规则" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton x:Name="OrderFileName" Content="文件名升序" GroupName="Order" IsChecked="True" />
                <RadioButton x:Name="OrderModified" Content="修改时间" GroupName="Order" />
                <RadioButton x:Name="OrderRandom" Content="随机" GroupName="Order" />
            </StackPanel>

            <CheckBox x:Name="RecursiveCheck" Content="递归子目录并保留相对路径结构" IsChecked="True" />
            <CheckBox x:Name="FastPreviewCheck" Content="快速预览模式（大图降采样至 960px，切换更快；默认 1920px）" />
            <CheckBox x:Name="PlayGifCheck" Content="播放 GIF 动画（默认只显示第一帧）" />

            <TextBlock Text="设置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FixedPinBox" MaxLength="8" InputScope="Number"
                         PlaceholderText="固定遥控 PIN（4-8 位数字；留空 = 每次启动随机）" />
                <Button Grid.Column="1" Content="保存设置" Click="SaveSettings_Click" />
            </Grid>

            <CheckBox x:Name="PrivacyCheck" Content="桌面隐私模式：电脑端不显示图片，只显示进度与操作记录（手机遥控不受影响）" />

            <TextBlock x:Name="SettingsStatusText" Foreground="Green" FontSize="12" TextWrapping="Wrap" />

            <Button x:Name="StartButton" Content="开始筛选" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left" Padding="32,10" Margin="0,16,0,0" Click="Start_Click" />

            <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="ServerStatusText" Foreground="#FF2E9E2E" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
